# API Keys for Multimodal Processing
# Copy this to .env and fill in your keys
# NEVER commit .env or hardcode keys in source code.

# Google Gemini API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (optional - used by features/multimodal_features.py for image analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Moonshot AI / Bedrock-compatible endpoint key (provided by the platform for image analysis)
BEDROCK_API_KEY=your_bedrock_api_key_here

# NVIDIA NIM API Key (optional - not needed, no multimodal support)
# NVIDIA_API_KEY=your_nvidia_key_here
