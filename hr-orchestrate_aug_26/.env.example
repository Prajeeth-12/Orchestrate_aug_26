# Optional API Keys for Live LLM Fallback Reasoning
# If provided, the Agent Orchestrator will dynamically reason over low-confidence predictions.
# If omitted, the system gracefully degrades to deterministic ML predictions.

# For OpenAI (GPT-4o)
OPENAI_API_KEY="sk-..."

# For Anthropic (Claude)
ANTHROPIC_API_KEY="..."

# For NVIDIA NIM (Llama 3.1)
NVIDIA_API_KEY="..."

# For AWS Bedrock (Moonshot)
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_DEFAULT_REGION="eu-north-1"
